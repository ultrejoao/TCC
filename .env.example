# Copie para .env e ajuste. O arquivo .env NAO vai para o versionamento.

# --- banco ---
POSTGRES_USER=tcc
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=tcc_motores
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- seguranca ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=gere-uma-chave-aleatoria-e-longa
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: origens do frontend, separadas por virgula ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- cookies: em producao (HTTPS) use true ---
COOKIE_SECURE=false

# --- containers ---
# Porta pela qual a aplicacao e acessada no navegador.
WEB_PORT=8080
MAX_UPLOAD_MB=50
